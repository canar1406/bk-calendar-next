{
	"name": "bkalendar-next",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "pnpm@11.19.0",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"check": "pnpm -r --if-present check",
		"dev": "pnpm --filter @bkalendar-next/web dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && pnpm check",
		"package:extension": "pnpm --filter @bkalendar-next/extension build && node scripts/package-extension.mjs",
		"test": "node --experimental-strip-types --test packages/*/test/*.test.ts apps/*/test/*.test.ts scripts/test/*.test.ts",
		"test:watch": "node --experimental-strip-types --test --watch packages/*/test/*.test.ts apps/*/test/*.test.ts scripts/test/*.test.ts"
	},
	"devDependencies": {
		"@types/chrome": "latest",
		"@types/node": "latest",
		"fflate": "^0.8.3",
		"prettier": "latest",
		"prettier-plugin-svelte": "latest",
		"typescript": "~6.0.0"
	}
}
