{
	"manifest_version": 3,
	"name": "BKalendar Next",
	"version": "0.2.0",
	"description": "Đọc thời khóa biểu MyBK cục bộ và báo trạng thái để bạn chủ động xem lại.",
	"permissions": ["storage"],
	"host_permissions": [
		"https://mybk.hcmut.edu.vn/app/he-thong-quan-ly/sinh-vien/tkb*",
		"https://canar1406.github.io/bk-calendar-next/*"
	],
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "BKalendar Next",
		"default_popup": "src/popup/index.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://mybk.hcmut.edu.vn/app/he-thong-quan-ly/sinh-vien/tkb*"],
			"js": ["content.js"]
		},
		{
			"matches": ["https://canar1406.github.io/bk-calendar-next/*"],
			"js": ["web-review.js"]
		}
	]
}
